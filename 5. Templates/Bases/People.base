filters:
  and:
    - categories.contains(link("People"))
    - '!file.name.contains("Template")'
properties:
  note.client_services:
    displayName: Client Services
  file.name:
    displayName: Name
views:
  - type: table
    name: Table
    groupBy:
      property: people_type
      direction: ASC
    order:
      - file.name
      - client_services
    sort:
      - property: client_services
        direction: ASC
    columnSize:
      file.name: 115
